Q2. Matrix Traversal
matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

print("Row-wise:")
for row in matrix:
    for element in row:
        print(element, end=" ")
    print()

print("Column-wise:")
for j in range(3):
    for i in range(3):
        print(matrix[i][j], end=" ")
    print()


Q3. Sum of Rows and Columns
rows = int(input("Enter rows: "))
cols = int(input("Enter columns: "))

matrix = []
for i in range(rows):
    row = list(map(int, input().split()))
    matrix.append(row)

for i in range(rows):
    print("Sum of row", i + 1, "=", sum(matrix[i]))

for j in range(cols):
    total = 0
    for i in range(rows):
        total += matrix[i][j]
    print("Sum of column", j + 1, "=", total)

Q4. Matrix Addition
