Q11. Matrix Operations
import numpy as np

A = np.array([[1, 2], [3, 4]])
B = np.array([[5, 6], [7, 8]])

print("Matrix multiplication:")
print(np.dot(A, B))

print("Transpose of A:")
print(A.T)

print("Manual multiplication:")
for i in range(2):
    for j in range(2):
        result = 0
        for k in range(2):
            result += A[i][k] * B[k][j]
        print(result, end=" ")
    print()


Q12. Real-World Dataset Analysis
import numpy as np

marks = np.array([
    [80, 75, 90],
    [65, 70, 85],
    [95, 88, 92]
])

for i in range(len(marks)):
    print("Student", i + 1,
          "Average:", np.mean(marks[i]))

print("Highest marks:", np.max(marks))
print("Lowest marks:", np.min(marks))