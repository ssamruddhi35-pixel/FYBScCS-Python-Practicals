Part A: Lists and Tuples
Q1. Creating Lists and Tuples
numbers = [10, 20, 30, 40, 50]
names = ("Amit", "Riya", "Neha")

print(numbers)
print(type(numbers))

print(names)
print(type(names))

Q2. Indexing in Lists and Tuples
numbers = [10, 20, 30, 40, 50]
values = ("A", "B", "C", "D", "E")

print("First:", numbers[0])
print("Last:", numbers[-1])
print("Middle:", numbers[2])

print("First:", values[0])
print("Last:", values[-1])
print("Middle:", values[2])


Q3. Slicing Lists and Tuples
numbers = [10, 20, 30, 40, 50]
values = ("A", "B", "C", "D", "E")

print(numbers[:3])
print(numbers[-2:])
print(numbers[::2])

print(values[:3])
print(values[-2:])
print(values[::2])

Q4. List Mutability vs Tuple Immutability
numbers = [10, 20, 30]
numbers[1] = 50
print("List:", numbers)

values = (10, 20, 30)

try:
    values[1] = 50
except TypeError:
    print("Tuple cannot be modified")


Q5. Adding Elements to a List
numbers = [10, 20, 30]

numbers.append(40)
numbers.insert(1, 15)

print(numbers)

Q6. Removing Elements from a List
numbers = [10, 20, 30, 40]

numbers.remove(20)
numbers.pop()

print(numbers)

try:
    numbers.remove(50)
except ValueError:
    print("Element not present")


Q7. List Methods – sort() and reverse()
numbers = [40, 10, 30, 20]

numbers.sort()
print("Ascending:", numbers)

numbers.sort(reverse=True)
print("Descending:", numbers)

numbers.reverse()
print("Reversed:", numbers)


Q8. Tuple Methods – count() and index()
values = (10, 20, 10, 30, 10)

print("Count:", values.count(10))
print("Index:", values.index(20))

if 50 in values:
    print(values.index(50))
else:
    print("Element not present")

Q9. Nested Lists
matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

print(matrix[0][1])
print(matrix[1][2])

matrix[1][2] = 10
print(matrix)


Q10. Converting Between List and Tuple
numbers = [10, 20, 30]
values = tuple(numbers)
print(values)

new_list = list(values)
new_list[0] = 100

print(new_list)


Q11. Iterating Through Lists and Tuples
numbers = [10, 20, 30, 40]
values = ("A", "B", "C")

for n in numbers:
    print(n)

print("Sum:", sum(numbers))

for v in values:
    print(v)

