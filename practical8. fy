Question 5: Removing Elements
student = {
    "Name": "Asha",
    "Age": 18,
    "Marks": 90
}

student.pop("Age")
del student["Marks"]

print(student)

student.pop("Class", "Not Found")

Question 6: Iterating Through Dictionary
student = {
    "Name": "Asha",
    "Age": 18,
    "Marks": 90
}

print("Keys:")
for key in student:
    print(key)

print("Values:")
for value in student.values():
    print(value)

print("Key-Value Pairs:")
for key, value in student.items():
    print(key, value)

Question 7: Dictionary Methods — keys(), values(), items()
student = {
    "Name": "Asha",
    "Age": 18,
    "Marks": 90
}

keys = list(student.keys())
values = list(student.values())
items = list(student.items())

print(keys)
print(values)
print(items)

Question 8: Counting Frequency of Characters
text = input("Enter a string: ")
frequency = {}

for char in text:
    frequency[char] = frequency.get(char, 0) + 1

print(frequency)

Question 9: Nested Dictionary
students = {
    "S1": {"Name": "Asha", "Marks": 90},
    "S2": {"Name": "Ravi", "Marks": 85}
}

